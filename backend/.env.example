DJANGO_DEBUG=True
# Set DJANGO_ENV=production and DJANGO_DEBUG=False for deployed environments.
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-development-only-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_TIME_ZONE=Asia/Kolkata
# DJANGO_BEHIND_PROXY=True
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_MAX_REQUEST_BYTES=1048576

# SQLite is the documented local fallback.
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL example for a production-like local setup:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ai_sprint

# Campaign configuration. The start date is intentionally blank by default;
# leave it blank to report all-time totals without inventing a campaign history.
CAMPAIGN_NAME=AI Sprint - Build Your First AI Project in 60 Minutes
CAMPAIGN_TARGET=500
CAMPAIGN_DURATION_DAYS=7
CAMPAIGN_BUDGET_INR=2000
# CAMPAIGN_START_DATE=2026-11-01
# CAMPAIGN_TIME_ZONE=Asia/Kolkata

